{
  "$schema": "https://opencode.ai/config.json",

  // Pod-of-Three: Akame (tech lead) + Sylvia (reviewer) + Ethan (design partner)

  "agent": {
    // Disable OpenCode's built-in agents so only the pod is routable.
    "build":   { "disable": true },
    "plan":    { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "scout":   { "disable": true },

    // TECH LEAD
    "Akame": {
      "description": "Tech lead and mentor for the deep learning infrastructure project. Owns roadmap, standups, backlog, and issue triage. Guides architecture, training decisions, and engineering discipline. Does not commit code or open PRs.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/akame.md}",
      "permission": { "edit": "ask" }
    },

    // CODE REVIEWER
    "Sylvia": {
      "description": "Rigorous, evidence-based code and tooling reviewer with expertise in ML systems, distributed training correctness, numerical stability, and reproducibility. Invoke on PRs and for periodic codebase health audits. Files GitHub issues for defects that outlive a PR. Never commits code.",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "prompt": "{file:./prompts/sylvia.md}",
      "permission": { "edit": "ask" }
    },

    // DESIGN PARTNER
    "Ethan": {
      "description": "Research scientist design partner. Uses the tool in a sandbox on realistic training and inference tasks. Files GitHub issues for bugs and feature requests from a real-usage perspective. Runs honest benchmarks on the provisioned hardware. Never commits code.",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "prompt": "{file:./prompts/ethan.md}",
      "permission": { "edit": "ask" }
    }
  }
}
